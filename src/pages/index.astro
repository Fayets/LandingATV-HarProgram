---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuizForm from '../components/QuizForm.astro';

const mockups = [
  { src: '/images/mockup-1-test.jpg', alt: 'Ejercicio de autoobservación: descubrí cómo estás llevando tu día a día.' },
  { src: '/images/mockup-2-descubri.jpg', alt: 'Descubrí cómo impacta tu día a día en 6 áreas de tu vida.' },
  { src: '/images/mockup-3-guia.jpg', alt: 'Recibí gratis una guía para gestionar tus emociones y recuperar el equilibrio.' },
];
---

<Layout>
  <Header />

  <main>
    <!-- TITULAR -->
    <h1>
      Descubrí gratis que esta sobrecargando tu mente<br />
      <span class="gold">y como reducirlo... En menos de 60 segundo</span>
    </h1>

    <!-- MOCKUP -->
    <div class="mockup-wrap">
      {mockups.map((m, i) => (
        <img
          class="imgMock"
          src={m.src}
          alt={m.alt}
          width="600"
          height="1158"
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
      ))}
    </div>

    <!-- FORMULARIO -->
    <QuizForm />

    <!-- BULLETS -->
    <ul class="bullets">
      <li><span class="dot"></span><span>Recibí tu resultado personalizado en menos de 60 segundos.</span></li>
      <li><span class="dot"></span><span>+500 personas ya identificaron la raiz de su sobrecarga.</span></li>
      <li><span class="dot"></span><span>100% gratuito — acceso instantáneo</span></li>
    </ul>

    <p class="fineprint">
      Al dejar tus datos aceptás que HAR se ponga en contacto con vos por teléfono, mensaje o email
      usando la información ingresada. No vendemos tu información personal. Al enviar el formulario
      aceptás nuestra Política de Privacidad y nuestros Términos de Servicio.
    </p>
  </main>

  <Footer />
</Layout>
