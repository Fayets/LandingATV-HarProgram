---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuizForm from '../components/QuizForm.astro';

const mockups = [
  { src: '/images/mockup-1-test.jpg', alt: 'Ejercicio de autoobservación: descubrí cómo estás llevando tu día a día.' },
  { src: '/images/mockup-2-descubri.jpg', alt: 'Descubrí cómo impacta tu día a día en 6 áreas de tu vida.' },
  { src: '/images/mockup-3-guia.jpg', alt: 'Recibí gratis una guía para reducir tu sobrecarga y recuperar el control.' },
];
---

<Layout>
  <Header />

  <main>
    <!-- TITULAR -->
    <h1>
      Descubrí gratis qué está sobrecargándote<br />
      <span class="gold">y cómo mejorarlo... En menos de 60 segundos</span>
    </h1>

    <div class="hero-grid">
      <!-- MOCKUP (izquierda en desktop, arriba en mobile) -->
      <div class="hero-visual">
        <div class="mockup-wrap">
          {mockups.map((m, i) => (
            <img
              class="imgMock"
              src={m.src}
              alt={m.alt}
              width="600"
              height="1158"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ))}
        </div>
      </div>

      <!-- FORMULARIO (derecha en desktop) -->
      <div class="hero-form">
        <QuizForm />
      </div>
    </div>

    <!-- CIFRAS -->
    <ul class="stats">
      <li><strong>+500</strong><span>personas ya identificaron la raíz de su sobrecarga</span></li>
      <li><strong>60 seg</strong><span>y recibís tu guía personalizada por WhatsApp</span></li>
      <li><strong>100%</strong><span>gratuito · acceso instantáneo</span></li>
    </ul>

    <p class="fineprint">
      Al dejar tus datos aceptás que HAR se ponga en contacto con vos por teléfono, mensaje o email
      usando la información ingresada. No vendemos tu información personal. Al enviar el formulario
      aceptás nuestra Política de Privacidad y nuestros Términos de Servicio.
    </p>
  </main>

  <Footer />
</Layout>
